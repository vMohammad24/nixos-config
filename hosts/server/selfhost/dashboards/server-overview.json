{
	"annotations": {
		"list": []
	},
	"editable": true,
	"graphTooltip": 1,
	"schemaVersion": 39,
	"tags": ["nixarr"],
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"timezone": "browser",
	"title": "Media Overview",
	"uid": "server-overview",
	"refresh": "30s",
	"templating": {
		"list": [
			{
				"type": "datasource",
				"name": "datasource",
				"label": "Data source",
				"query": "prometheus",
				"hide": 0,
				"current": {},
				"refresh": 1,
				"regex": ""
			}
		]
	},
	"panels": [
		{
			"type": "row",
			"title": "Media",
			"gridPos": {
				"h": 1,
				"w": 24,
				"x": 0,
				"y": 0
			},
			"id": 101
		},
		{
			"type": "stat",
			"title": "Services Up",
			"id": 9,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 8,
				"x": 0,
				"y": 1
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"mappings": [
						{
							"type": "value",
							"options": {
								"0": {
									"text": "DOWN",
									"color": "red"
								},
								"1": {
									"text": "UP",
									"color": "green"
								}
							}
						}
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "red",
								"value": null
							},
							{
								"color": "green",
								"value": 1
							}
						]
					}
				},
				"overrides": []
			},
			"options": {
				"colorMode": "background",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": ""
				},
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "sonarr_system_status",
					"legendFormat": "sonarr"
				},
				{
					"refId": "B",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "radarr_system_status",
					"legendFormat": "radarr"
				},
				{
					"refId": "C",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "prowlarr_system_status",
					"legendFormat": "prowlarr"
				}
			]
		},
		{
			"type": "stat",
			"title": "Sonarr Series",
			"id": 10,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 8,
				"y": 1
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "blue"
					}
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"]
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "sonarr_series_total"
				}
			]
		},
		{
			"type": "stat",
			"title": "Sonarr Queue",
			"id": 11,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 12,
				"y": 1
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "purple"
					}
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"]
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "sonarr_queue_total"
				}
			]
		},
		{
			"type": "stat",
			"title": "Radarr Movies",
			"id": 12,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 16,
				"y": 1
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "blue"
					}
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"]
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "radarr_movie_total"
				}
			]
		},
		{
			"type": "stat",
			"title": "Radarr Queue",
			"id": 13,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 4,
				"x": 20,
				"y": 1
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "purple"
					}
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"]
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "radarr_queue_total"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Missing (Sonarr eps / Radarr movies)",
			"id": 14,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 5
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"fillOpacity": 10
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "sonarr_episode_missing_total",
					"legendFormat": "sonarr episodes"
				},
				{
					"refId": "B",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "radarr_movie_missing_total",
					"legendFormat": "radarr movies"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Prowlarr query rate",
			"id": 15,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 5
			},
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"custom": {
						"fillOpacity": 10
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "sum by(indexer) (rate(prowlarr_indexer_queries_total[5m]))",
					"legendFormat": "{{indexer}}"
				}
			]
		},
		{
			"type": "row",
			"title": "VPN",
			"gridPos": {
				"h": 1,
				"w": 24,
				"x": 0,
				"y": 13
			},
			"id": 102
		},
		{
			"type": "timeseries",
			"title": "WireGuard throughput",
			"id": 16,
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 8,
				"w": 24,
				"x": 0,
				"y": 14
			},
			"fieldConfig": {
				"defaults": {
					"unit": "Bps",
					"custom": {
						"fillOpacity": 10
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "rate(wireguard_received_bytes_total[5m])",
					"legendFormat": "received"
				},
				{
					"refId": "B",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "rate(wireguard_sent_bytes_total[5m])",
					"legendFormat": "sent"
				}
			]
		}
	]
}
