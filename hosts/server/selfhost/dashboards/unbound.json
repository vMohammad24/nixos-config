{
	"annotations": { "list": [] },
	"editable": true,
	"graphTooltip": 1,
	"panels": [
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"mappings": [
						{
							"options": {
								"0": { "color": "red", "text": "DOWN" },
								"1": { "color": "green", "text": "UP" }
							},
							"type": "value"
						}
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "green", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
			"id": 1,
			"options": {
				"colorMode": "background",
				"graphMode": "none",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "unbound_up{job=\"unbound\"}",
					"legendFormat": "Unbound",
					"refId": "A"
				}
			],
			"title": "Status",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
			"gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
			"id": 2,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				}
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(rate(unbound_queries_total{job=\"unbound\"}[$__rate_interval]))",
					"refId": "A"
				}
			],
			"title": "Queries / second",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"max": 100,
					"min": 0,
					"unit": "percent",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "yellow", "value": 50 },
							{ "color": "green", "value": 80 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
			"id": 3,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				}
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "100 * sum(rate(unbound_cache_hits_total{job=\"unbound\"}[$__rate_interval])) / clamp_min(sum(rate(unbound_cache_hits_total{job=\"unbound\"}[$__rate_interval])) + sum(rate(unbound_cache_misses_total{job=\"unbound\"}[$__rate_interval])), 1e-9)",
					"refId": "A"
				}
			],
			"title": "Cache hit ratio",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
			"gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
			"id": 4,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				}
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "unbound_recursion_time_seconds_avg{job=\"unbound\"}",
					"refId": "A"
				}
			],
			"title": "Average recursion time",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
			"gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
			"id": 5,
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				}
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "unbound_time_up_seconds_total{job=\"unbound\"}",
					"refId": "A"
				}
			],
			"title": "Uptime",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
			"id": 6,
			"options": {
				"legend": {
					"calcs": ["mean", "max"],
					"displayMode": "table",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(rate(unbound_queries_total{job=\"unbound\"}[$__rate_interval]))",
					"legendFormat": "queries",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(rate(unbound_cache_hits_total{job=\"unbound\"}[$__rate_interval]))",
					"legendFormat": "cache hits",
					"refId": "B"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(rate(unbound_cache_misses_total{job=\"unbound\"}[$__rate_interval]))",
					"legendFormat": "cache misses",
					"refId": "C"
				}
			],
			"title": "Query and cache rates",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
			"id": 7,
			"options": {
				"legend": {
					"calcs": ["mean"],
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum by (rcode) (rate(unbound_answer_rcodes_total{job=\"unbound\"}[$__rate_interval]))",
					"legendFormat": "{{rcode}}",
					"refId": "A"
				}
			],
			"title": "Responses by code",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
			"id": 8,
			"options": {
				"legend": {
					"calcs": ["mean"],
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "topk(10, sum by (type) (rate(unbound_query_types_total{job=\"unbound\"}[$__rate_interval])))",
					"legendFormat": "{{type}}",
					"refId": "A"
				}
			],
			"title": "Top query types",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
			"id": 9,
			"options": {
				"legend": {
					"calcs": ["mean", "max"],
					"displayMode": "table",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(unbound_request_list_current_all{job=\"unbound\"})",
					"legendFormat": "all",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(unbound_request_list_current_user{job=\"unbound\"})",
					"legendFormat": "client",
					"refId": "B"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(unbound_request_list_current_replies{job=\"unbound\"})",
					"legendFormat": "waiting replies",
					"refId": "C"
				}
			],
			"title": "Request list",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
			"id": 10,
			"options": {
				"legend": {
					"calcs": ["lastNotNull"],
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "unbound_memory_caches_bytes{job=\"unbound\"}",
					"legendFormat": "cache: {{cache}}",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "unbound_memory_modules_bytes{job=\"unbound\"}",
					"legendFormat": "module: {{module}}",
					"refId": "B"
				}
			],
			"title": "Memory usage",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
			"id": 11,
			"options": {
				"legend": {
					"calcs": ["mean", "max"],
					"displayMode": "table",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "rate(unbound_answers_secure_total{job=\"unbound\"}[$__rate_interval])",
					"legendFormat": "secure",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "rate(unbound_answers_bogus{job=\"unbound\"}[$__rate_interval])",
					"legendFormat": "bogus",
					"refId": "B"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "rate(unbound_unwanted_queries_total{job=\"unbound\"}[$__rate_interval])",
					"legendFormat": "unwanted",
					"refId": "C"
				}
			],
			"title": "Validation and rejected queries",
			"type": "timeseries"
		}
	],
	"refresh": "30s",
	"schemaVersion": 39,
	"tags": ["dns", "unbound"],
	"templating": {
		"list": [
			{
				"current": {},
				"hide": 0,
				"label": "Data source",
				"name": "datasource",
				"query": "prometheus",
				"refresh": 1,
				"regex": "",
				"type": "datasource"
			}
		]
	},
	"time": { "from": "now-6h", "to": "now" },
	"title": "Unbound DNS",
	"uid": "unbound-dns",
	"version": 1
}
