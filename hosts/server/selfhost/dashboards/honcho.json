{
	"annotations": { "list": [] },
	"editable": true,
	"graphTooltip": 1,
	"panels": [
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 5 },
							{ "color": "red", "value": 20 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
			"id": 1,
			"options": {
				"colorMode": "background",
				"graphMode": "area",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "max(deriver_queue_items_pending{job=\"honcho\"})",
					"legendFormat": "pending",
					"refId": "A"
				}
			],
			"title": "Ingestion backlog",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 600 },
							{ "color": "red", "value": 1800 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
			"id": 2,
			"options": {
				"colorMode": "background",
				"graphMode": "area",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "max(deriver_queue_oldest_pending_age_seconds{job=\"honcho\"})",
					"legendFormat": "oldest pending",
					"refId": "A"
				}
			],
			"title": "Oldest pending age",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 4, "x": 9, "y": 0 },
			"id": 3,
			"options": {
				"colorMode": "background",
				"graphMode": "area",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "max(dreams_due{job=\"honcho\"})",
					"legendFormat": "due",
					"refId": "A"
				}
			],
			"title": "Dreams due",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 300 },
							{ "color": "red", "value": 900 }
						]
					}
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 5, "x": 13, "y": 0 },
			"id": 4,
			"options": {
				"colorMode": "background",
				"graphMode": "area",
				"reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
				"textMode": "value_and_name"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "time() - max(deriver_metrics_last_success_timestamp_seconds{job=\"honcho\"})",
					"legendFormat": "since poll",
					"refId": "A"
				}
			],
			"title": "Queue poller freshness",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
			"id": 5,
			"options": {
				"legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{job=\"honcho\",endpoint!=\"unknown\"}[$__rate_interval])))",
					"legendFormat": "p95 all endpoints",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_duration_seconds_bucket{job=\"honcho\",endpoint!=\"unknown\"}[$__rate_interval])))",
					"legendFormat": "p50 all endpoints",
					"refId": "B"
				}
			],
			"title": "API latency",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } },
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
			"id": 6,
			"options": {
				"legend": { "calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum by (reasoning_level, token_type) (rate(dialectic_tokens_processed_total{job=\"honcho\"}[$__rate_interval]))",
					"legendFormat": "{{reasoning_level}} {{token_type}}",
					"refId": "A"
				}
			],
			"title": "Dialectic tokens per second",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
				"overrides": []
			},
			"gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
			"id": 7,
			"options": {
				"legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "max_over_time(message_embeddings_pending{job=\"honcho\"}[$__rate_interval])",
					"legendFormat": "pending",
					"refId": "A"
				},
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "max_over_time(message_embeddings_pending_due{job=\"honcho\"}[$__rate_interval])",
					"legendFormat": "pending due",
					"refId": "B"
				}
			],
			"title": "Embedding backlog",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"fieldConfig": {
				"defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1 } },
				"overrides": []
			},
			"gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
			"id": 8,
			"options": {
				"legend": { "calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum by (workspace_name) (rate(messages_created_total{job=\"honcho\"}[$__rate_interval]))",
					"legendFormat": "{{workspace_name}}",
					"refId": "A"
				}
			],
			"title": "Messages per second",
			"type": "timeseries"
		}
	],
	"refresh": "30s",
	"schemaVersion": 39,
	"tags": ["honcho", "memory"],
	"templating": {
		"list": [
			{
				"current": {},
				"hide": 0,
				"label": "Data source",
				"name": "datasource",
				"query": "prometheus",
				"refresh": 1,
				"regex": "",
				"type": "datasource"
			}
		]
	},
	"time": { "from": "now-24h", "to": "now" },
	"title": "Honcho Memory",
	"uid": "honcho-memory",
	"version": 1
}
